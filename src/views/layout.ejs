<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>CRUD-COMPUTERSHOP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-slate-100 text-slate-800">

<!-- NAVBAR -->
<nav class="bg-[#0F172A] border-b border-slate-700">
  <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">

    <!-- LOGO -->
    <a href="/articulos"
       class="text-white font-semibold text-lg tracking-wide hover:text-indigo-300 transition">
      CRUD | COMPUTERSHOP
    </a>

    <!-- BOTÓN NUEVO ARTÍCULO -->
    <a href="/articulos/nuevo"
       class="flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700
              px-4 py-2 rounded-lg text-white font-semibold transition shadow">

      <svg xmlns="http://www.w3.org/2000/svg"
           fill="none" viewBox="0 0 24 24"
           stroke-width="2" stroke="currentColor"
           class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 6v12m6-6H6" />
      </svg>

      Nuevo artículo
    </a>

  </div>
</nav>


<!-- CONTENIDO -->
<main class="max-w-7xl mx-auto px-6 py-10">
  <%- body %>
</main>

<!-- FOOTER -->
<footer class="text-center py-4 text-xs text-slate-500">
  CRUD-COMPUTERSHOP | Anthony Guzman
</footer>

</body>
</html>
